<Project>

  <!-- Shared MSBuild properties for all projects in the solution -->

  <PropertyGroup>
    <!-- Target framework — Windows 11 only (requires .NET 8 SDK+) -->
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>

    <!-- Language version -->
    <LangVersion>latest</LangVersion>

    <!-- Nullable reference types enabled globally -->
    <Nullable>enable</Nullable>

    <!-- Implicit usings enabled -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Treat warnings as errors — disabled during early development.
      Enable when codebase stabilizes and all CA rules are addressed.
    -->
    <!-- <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors> -->

    <!-- Generate XML documentation files -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Suppress specific warnings -->
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1574</NoWarn>
    <!--
      CS1591: Missing XML comment for publicly visible type/member
      CS1572: XML comment has param tag but no matching parameter
      CS1573: Parameter has no matching param tag
      CS1574: XML comment cref could not be resolved
    -->

    <!-- Enable .NET analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      Suppress specific CA rules that are intentional design decisions:
      CA1031: Catch more specific exception (intentional in native callback dispatchers)
      CA1032: Add standard exception constructors (added as needed)
      CA1062: Validate parameter is non-null (addressed in public API review)
      CA1069: Enum member has same value as another (intentional for native API mapping)
      CA1805: Member explicitly initialized to default (intentional for clarity)
      CA1806: Use HRESULT from P/Invoke (intentional for non-critical calls)
      CA1812: Internal class never instantiated (will be used by sync engine)
      CA1822: Member can be static (intentional for future instance use)
      CA2007: Call ConfigureAwait (not needed in library code without SynchronizationContext)
      CA5392: DefaultDllImportSearchPaths for P/Invoke (system32 DLLs only)
    -->
    <NoWarn>$(NoWarn);CA1031;CA1032;CA1062;CA1069;CA1805;CA1806;CA1812;CA1822;CA2007;CA5392</NoWarn>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>

    <!-- Skip PRI resource generation for class libraries (only needed for MSIX packaging) -->
    <GenerateLibraryLayout>false</GenerateLibraryLayout>

    <!-- Assembly metadata -->
    <Company>NasSync</Company>
    <Product>NAS Cloud Sync Client</Product>
    <Copyright>Copyright © 2026</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

</Project>
