<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSync.CfApi</RootNamespace>
    <AssemblyName>NasSync.CfApi</AssemblyName>
    <Description>P/Invoke wrapper for Windows Cloud Filter API (CfAPI) — manages sync roots, placeholders, hydration callbacks, and data transfer.</Description>

    <!-- Allow unsafe code for P/Invoke pointer operations and fixed buffers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NOTE: WinRT interop (StorageProviderSyncRootManager) requires the Windows App SDK
    and Visual Studio build tools for PRI resource generation. The WinRtRegistration.cs
    file is excluded from CLI builds. To enable WinRT navigation pane integration:
    1. Install "Windows App SDK" workload in Visual Studio Installer
    2. Uncomment the PackageReference below
    3. Uncomment CsWinRTEnabled and CsWinRTWindowsMetadata
    4. Build via Visual Studio or with MSBuild from Developer Command Prompt
  -->
  <!--
  <PropertyGroup>
    <CsWinRTEnabled>true</CsWinRTEnabled>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.*" />
  </ItemGroup>
  -->

</Project>
