<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSync.CfApi</RootNamespace>
    <AssemblyName>NasSync.CfApi</AssemblyName>
    <Description>P/Invoke wrapper for Windows Cloud Filter API (CfAPI) — manages sync roots, placeholders, hydration callbacks, and data transfer.</Description>

    <!-- Allow unsafe code for P/Invoke pointer operations and fixed buffers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      WinRT interop:
      - WinRtRegistration.cs is gated by #if WINRT_ENABLED preprocessor directive
      - Define WINRT_ENABLED during build to enable navigation pane WinRT integration
      - CI builds pass /p:DefineConstants=WINRT_ENABLED
      - Visual Studio builds can add WINRT_ENABLED to project properties
    -->
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.*" />
  </ItemGroup>

</Project>
