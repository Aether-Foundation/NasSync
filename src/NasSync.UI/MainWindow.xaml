<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NasSync.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NAS Cloud Sync Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="16" MaxWidth="560">

            <!-- Header Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="NAS Cloud Sync" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Text="Version 0.1.0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Sync Status Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sync Status" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State:" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateText" Text="Unknown"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Queue:" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="QueueText" Text="0 pending"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseResumeButton" Content="Pause" Click="OnPauseResume"
                                Style="{StaticResource AccentButtonStyle}" MinWidth="80" />
                        <Button x:Name="ScanButton" Content="Full Scan" Click="OnFullScan" MinWidth="80" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Configuration Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Configuration" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="NAS Directory (server)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ServerDirBox" Grid.Column="0"
                                     PlaceholderText="Path to NAS folder" />
                            <Button Grid.Column="1" Content="Browse" Click="OnBrowseServer" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Sync Folder (local cloud)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="SyncRootBox" Grid.Column="0"
                                     PlaceholderText="Path to sync folder" />
                            <Button Grid.Column="1" Content="Browse" Click="OnBrowseSyncRoot" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="SaveButton" Content="Apply &amp; Restart" Click="OnSave"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" MinWidth="120" />
                </StackPanel>
            </Border>

            <!-- Recent Operations Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent Operations" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="OperationsList" MaxHeight="300"
                              SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4">
                                    <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="16"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="NAS Cloud Sync Client" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="Built with .NET 8 + WinUI 3"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="© 2026 NasSync"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
