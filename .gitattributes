# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized to LF line endings
*.cs text
*.csproj text
*.props text
*.targets text
*.sln text
*.xaml text
*.resw text
*.md text
*.json text
*.xml text
*.config text
*.editorconfig text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.svg binary
*.dll binary
*.exe binary
*.msix binary
*.pfx binary
*.snk binary
